{
	"compilerOptions": {
		"strict": true,
		"target": "ES2025",
		"lib": ["ES2025"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node", "bun"],
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src", "test", "tsup.config.ts"]
}
